FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

WORKDIR /app

RUN pip install --no-cache-dir uv==0.9.15
COPY requirements.railway.lock /app/requirements.railway.lock
RUN uv pip install --system --no-cache --require-hashes --only-binary :all: -r /app/requirements.railway.lock

COPY src /app/src

EXPOSE 8003

CMD ["sh", "-c", "uvicorn main:app --host 0.0.0.0 --port ${PORT:-8003} --no-access-log"]
